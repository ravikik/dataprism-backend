{
  "name": "Custom Data Quality Monitoring",
  "description": "Custom implementation of data quality monitoring using classic compute",
  "email_notifications": {
    "on_failure": ["data-team@company.com"],
    "on_success": []
  },
  "webhook_notifications": {
    "on_failure": [
      {
        "id": "slack-webhook-id"
      }
    ]
  },
  "timeout_seconds": 3600,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "run_monitoring",
      "description": "Execute data quality monitoring",
      "notebook_task": {
        "notebook_path": "/Workspace/monitoring/custom_quality_monitoring",
        "base_parameters": {}
      },
      "new_cluster": {
        "spark_version": "13.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 2,
        "spark_conf": {
          "spark.databricks.delta.preview.enabled": "true"
        },
        "aws_attributes": {
          "availability": "SPOT_WITH_FALLBACK",
          "spot_bid_price_percent": 100,
          "ebs_volume_type": "GENERAL_PURPOSE_SSD",
          "ebs_volume_count": 1,
          "ebs_volume_size": 100
        },
        "custom_tags": {
          "Project": "DataQualityMonitoring",
          "Environment": "Production",
          "CostCenter": "DataEngineering"
        }
      },
      "timeout_seconds": 0,
      "email_notifications": {}
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 */6 * * ?",
    "timezone_id": "America/New_York",
    "pause_status": "UNPAUSED"
  },
  "format": "MULTI_TASK"
}
