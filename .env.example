# DataPrism AI Configuration
# The app works without any keys (mock/demo mode)
# Add keys below to enable live AI and data platform features

# ── Claude AI (enables AI-powered responses) ──
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── MCP Server Mode (Optional) ──
# Set to 'true' to use Model Context Protocol servers instead of direct API calls
# Benefits: Tools become reusable by Claude Desktop and other MCP clients
USE_MCP=false

# ── Databricks OAuth 2.0 (Recommended for Production) ──
# Create an OAuth app in Databricks workspace settings
# Provides user-based authentication and automatic token refresh
DATABRICKS_OAUTH_CLIENT_ID=your-oauth-client-id
DATABRICKS_OAUTH_CLIENT_SECRET=your-oauth-client-secret
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# ── Backend Databricks Configuration (Alternative) ──
# Configure Databricks credentials in backend instead of frontend Settings
# Uncomment these to use backend credentials (users won't need to enter them in UI)
# DATABRICKS_TOKEN=dapi-your-personal-access-token-here
# DATABRICKS_WAREHOUSE_ID=your-warehouse-id-here
# Note: DATABRICKS_HOST is already set above

# ── Session Security ──
# Generate a strong random secret for production
SESSION_SECRET=change-this-to-a-strong-random-secret-in-production

# ── Admin Settings Access ──
# Set a secure token to access the settings admin UI at /admin/settings
# In development, this is optional. In production, it's required for security.
# ADMIN_TOKEN=your-secure-admin-token-here

# ── Server Configuration ──
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── AWS (optional — enables infrastructure queries) ──
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# ── Vector Database Configuration (Optional) ──
# Choose vector DB for semantic caching: pinecone, pgvector, qdrant
# VECTOR_DB_TYPE=pgvector

# ── PostgreSQL with pgvector (Self-Hosted Vector DB) ──
# Install pgvector extension: https://github.com/pgvector/pgvector
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-postgres-password
# POSTGRES_DATABASE=dataprism
# POSTGRES_SSL=false  # Set to true for AWS RDS or Azure PostgreSQL

# For AWS RDS PostgreSQL (PostgreSQL 15.2+ includes pgvector):
# POSTGRES_HOST=dataprism.xxxxx.us-east-1.rds.amazonaws.com
# POSTGRES_SSL=true

# ── Pinecone Vector DB (SaaS Alternative) ──
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_ENVIRONMENT=us-east-1-aws
# PINECONE_INDEX=dataprism-cache

# ── Redis Cache (Optional but Recommended) ──
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_TTL=3600  # Default TTL in seconds
